# RFP Answer Generator Configuration

# Application Settings
DEBUG=true
APP_NAME="RFP Answer Generator"

# LLM Settings (Optional - for enhanced answer generation)
# Set USE_LLM=true to enable LLM-enhanced answer generation
USE_LLM=false
LLM_PROVIDER=openai  # Options: openai, anthropic

# OpenAI API Key (required if LLM_PROVIDER=openai and USE_LLM=true)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (required if LLM_PROVIDER=anthropic and USE_LLM=true)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Search Settings
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3

# Text Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
